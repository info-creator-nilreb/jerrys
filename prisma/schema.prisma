}

/// CMS-light Veröffentlichungsstatus (Epic 12 / ADR-0007).
enum ContentPageStatus {
  draft
  published
}

/// Inhaltsseite mit SEO und Draft/Publish (Epic 12). Öffentliches Routing ab Slice 5.
model ContentPage {
  id     String            @id @default(cuid())
  /// URL-Segment ohne führenden Slash; Homepage-Sentinel: `home` (öffentlich `/`).
  slug   String            @unique
  pageType ContentPageType @map("page_type")
  status   ContentPageStatus @default(draft)

  title String

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogImageUrl     String? @map("og_image_url")
  /// Optionaler Canonical-Pfad (z. B. `/impressum`); null = aus Slug abgeleitet.
  canonicalPath  String? @map("canonical_path")
  robotsIndex    Boolean @default(true) @map("robots_index")
  /// Opt-in: veröffentlichte Content-Seite im Storefront-Footer verlinken.
  showInFooter   Boolean @default(false) @map("show_in_footer")

  /// Vorheriger Slug für 301-Redirect nach URL-Wechsel (Slice 5).
  previousSlug String? @map("previous_slug")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  blocks ContentBlock[]

  @@index([status, pageType])
  @@index([previousSlug])
  @@map("content_pages")
}

/// Geordneter Inhaltsblock einer ContentPage (Epic 12). `data` per Block-Typ Zod-validiert (Slice 2+).
model ContentBlock {
  id        String   @id @default(cuid())
  pageId    String   @map("page_id")
