  preferredStartsAt  DateTime  @map("preferred_starts_at")
  seatCount          Int       @default(1) @map("seat_count")
  message            String?
  /// pending | approved | rejected
  status             String    @default("pending")
  adminNote          String?   @map("admin_note")
  approvedSessionId  String?   @unique @map("approved_session_id")
  approvedSession    WorkshopSession? @relation("ApprovedWorkshopDateRequest", fields: [approvedSessionId], references: [id], onDelete: SetNull)
  resolvedAt         DateTime? @map("resolved_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([contactEmail, createdAt])
  @@map("workshop_date_requests")
}

/// Buchung eines Kunden oder Gastes für einen Gruppentermin.
model WorkshopBooking {
  id                       String   @id @default(cuid())
  sessionId                String   @map("session_id")
  session                  WorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  customerId               String?  @map("customer_id")
  customer                 Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId                  String?  @map("order_id")
  contactEmail             String   @map("contact_email")
  seatCount                Int      @map("seat_count")
  /// held | confirmed | cancelled | attended | no_show | refunded | expired
  status                   String   @default("confirmed")
  sessionTitleSnapshot     String   @map("session_title_snapshot")
  sessionStartsAtSnapshot  DateTime @map("session_starts_at_snapshot")
  sessionTimezoneSnapshot  String   @map("session_timezone_snapshot")
  sessionLocationSnapshot  String   @map("session_location_snapshot")
  unitPriceCentsSnapshot   Int      @map("unit_price_cents_snapshot")
  currencySnapshot         String   @default("EUR") @map("currency_snapshot")
  cancelledAt              DateTime? @map("cancelled_at")
  cancelReason             String?  @map("cancel_reason")
  /// Epic 5 Slice 3: Ablauf für Checkout-Hold (status = held).
  holdExpiresAt            DateTime? @map("hold_expires_at")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  events                   WorkshopBookingEvent[]

  @@index([customerId, createdAt])
  @@index([sessionId, status])
  @@map("workshop_bookings")
}

model WorkshopBookingEvent {
  id        String   @id @default(cuid())
  bookingId String   @map("booking_id")
  booking   WorkshopBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([bookingId, createdAt])
  @@map("workshop_booking_events")
}

model WorkshopSessionEvent {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  session   WorkshopSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("workshop_session_events")
}
