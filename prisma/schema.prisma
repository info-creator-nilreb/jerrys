// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Admin authentication subject (Auth.js Credentials + JWT session).
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("admin")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("admin_users")
}

/// Storefront customer account (Epic 3). Not derived from order emails.
model Customer {
  id              String    @id @default(cuid())
  /// Normalized lowercase email; unique identity anchor after verification.
  email           String    @unique
  emailVerifiedAt DateTime? @map("email_verified_at")
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  /// Null until a password is set (magic-link-only accounts possible later).
  passwordHash    String?   @map("password_hash")
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  /// Set when the account was anonymized on customer request (Epic 3 Slice 6).
  /// Order snapshots stay for statutory retention; the account link is removed.
  anonymizedAt    DateTime? @map("anonymized_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  identities CustomerIdentity[]
  authTokens CustomerAuthToken[]
  orders           Order[]
  addresses        CustomerAddress[]
  workshopBookings WorkshopBooking[]
  workshopDateRequests WorkshopDateRequest[]

  @@index([isActive, createdAt])
  @@map("customers")
}

/// Saved shipping/billing address for a customer (Epic 3 Slice 3). Orders keep immutable snapshots.
model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// shipping | billing
  kind       String
  label      String?  @map("label")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  company    String?  @map("company")
  line1      String   @map("line1")
  line2      String?  @map("line2")
  zip        String   @map("zip")
  city       String   @map("city")
  country    String   @default("DE") @map("country")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([customerId, kind])
  @@index([customerId, kind, isDefault])
  @@map("customer_addresses")
}

/// Auth provider binding for a customer (password, magic_link, …).
model CustomerIdentity {
  id              String   @id @default(cuid())
  customerId      String   @map("customer_id")
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// e.g. password | magic_link
  provider        String
  /// Stable subject within provider (normalized email for first-party providers).
  providerSubject String   @map("provider_subject")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerSubject])
  @@index([customerId])
  @@map("customer_identities")
}

/// One-time hashed tokens for email verify, magic link, password reset.
model CustomerAuthToken {
  id         String    @id @default(cuid())
  customerId String    @map("customer_id")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// email_verify | magic_link | password_reset
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([customerId, purpose])
  @@index([expiresAt])
  @@map("customer_auth_tokens")
}

model Manufacturer {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  products  Product[]

  @@map("manufacturers")
}

model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  subtitle    String?
  /// Rich-Text-HTML (nach Speichern serverseitig bereinigt).
  description String?
  manufacturerId String?     @map("manufacturer_id")
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)
  productNumber  String?     @map("product_number")

  currency    String         @default("EUR")

  isActive    Boolean        @default(true) @map("is_active")
  sortOrder   Int            @default(0) @map("sort_order")
  /// Manuell gepflegte Amazon-Sterne (0–5) und Anzahl; URL zur Produktseite. Kein automatischer Abruf.
  amazonRatingAverage Float?   @map("amazon_rating_average")
  amazonRatingCount   Int?     @map("amazon_rating_count")
  amazonReviewUrl       String?  @map("amazon_review_url")

  /// Kategorie-/Claim-Zeile auf der Produktdetailseite (z. B. „FÜR AUGE & GAUMEN“).
  categoryTag   String?  @map("category_tag")
  isBestseller  Boolean  @default(false) @map("is_bestseller")
  /// Kurzer Klartext unter dem Untertitel (nicht HTML).
  leadText      String?  @map("lead_text")
  dimensionsText String? @map("dimensions_text")
  weightText       String? @map("weight_text")
  materialText     String? @map("material_text")
  featureBullets     String[] @default([]) @map("feature_bullets")
  /// Shopify-ähnliche Merkmale: [{ key, label, values: string[] }]
  attributes         Json     @default("[]")
  /// Epic 5: Gruppentermin-Kalender auf der Produktdetailseite einblenden.
  showWorkshopCalendar Boolean @default(false) @map("show_workshop_calendar")

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  images      ProductImage[]
  variants    ProductVariant[]
  collectionMemberships CollectionProduct[]
  cartLines   CartLine[]
  orderItems  OrderItem[]
  stockReservations StockReservation[]
  stockMovements    StockMovement[]
  /// Öffentliches Suchdokument / Embedding-Index (Epic 14 Slice 2).
  searchDocument ProductSearchDocument?

  @@index([isActive, sortOrder])
  @@map("products")
}

/// Verkaufbare SKU (Epic 2); Preis und Bestand sind variantenspezifisch.
model ProductVariant {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String   @unique
  title       String?

  priceGrossCents Int        @map("price_gross_cents")
  priceNetCents   Int        @map("price_net_cents")
  taxRatePercent  Int        @default(19) @map("tax_rate_percent")
  listPriceGrossCents Int?   @map("list_price_gross_cents")
  listPriceNetCents   Int?   @map("list_price_net_cents")
  lowestPrice30dGrossCents Int? @map("lowest_price_30d_gross_cents")
  lowestPrice30dNetCents   Int? @map("lowest_price_30d_net_cents")

  stockQuantity     Int @default(0) @map("stock_quantity")
  availableQuantity Int @default(0) @map("available_quantity")
  deliveryTimeKey   String? @map("delivery_time_key")
  restockDays       Int?    @map("restock_days")
  minOrderQty       Int     @default(1) @map("min_order_qty")
  purchaseStep      Int     @default(1) @map("purchase_step")
  maxOrderQty       Int?    @map("max_order_qty")

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cartLines         CartLine[]
  orderItems        OrderItem[]
  stockReservations StockReservation[]
  stockMovements    StockMovement[]
  zettleMapping     ZettleProductMapping?

  @@index([productId, isDefault])
  @@index([productId, isActive, sortOrder])
  @@map("product_variants")
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  products    CollectionProduct[]
  /// Kategorien, die diese Kollektion in der Shop-Navigation/Listings einbinden.
  categoryLinks CategoryCollection[]

  @@index([isActive, sortOrder])
  @@map("collections")
}

model CollectionProduct {
  collectionId String @map("collection_id")
  productId    String @map("product_id")
  sortOrder    Int    @default(0) @map("sort_order")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

/// Browse-Taxonomie / Primary Nav (Epic 10). Produkte kommen nur über verknüpfte Kollektionen.
model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  parentId    String?  @map("parent_id")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  collections CategoryCollection[]

  @@index([isActive, sortOrder])
  @@index([parentId])
  @@map("categories")
}

/// Kategorie ← Kollektion (Shopify-ähnlich: Nav/IA bindet Kollektionen, nicht einzelne Produkte).
model CategoryCollection {
  categoryId   String @map("category_id")
  collectionId String @map("collection_id")
  sortOrder    Int    @default(0) @map("sort_order")
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([categoryId, collectionId])
  @@index([collectionId])
  @@map("category_collections")
}

/// Globale Versandkonfiguration (genau eine Zeile, id = default).
model ShopShippingSettings {
  id     String @id
  /// Aktive Lieferländer (ISO-3166-1-alpha-2), Checkout-Auswahl.
  shippingCountryCodes String[] @default(["DE"]) @map("shipping_country_codes")
  /// Brutto-Versandkosten in Cent pro Land, z. B. {"DE":499,"AT":899}
  shippingRatesCentsByCountry Json @default("{}") @map("shipping_rates_cents_by_country")
  /// Ab diesem Warenkorb-Brutto (Cent) entfällt der Versand (optional).
  freeShippingFromSubtotalGrossCents Int? @map("free_shipping_from_subtotal_gross_cents")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shop_shipping_settings")
}

/// Gäste-Warenkorb; Zuordnung über httpOnly-Cookie `jerrys_cart_id`.
model Cart {
  id           String     @id @default(cuid())
  customerNote String?    @map("customer_note")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  lines        CartLine[]

  @@map("carts")
}

enum OrderPaymentStatus {
  pending
  processing
  succeeded
  partially_refunded
  failed
  canceled
  refunded
}

/// Versand-/Fulfillment-Achse (Epic 1), getrennt vom aggregierten Bestellstatus.
enum FulfillmentStatus {
  unfulfilled
  preparing
  shipped
  delivered
  returned
}

/// Sendungs-Lebenszyklus (Epic 7). Getrennt von Order.fulfillmentStatus / Zahlungsstatus.
enum ShipmentStatus {
  draft
  labeled
  shipped
  delivered
  voided
  returned
}

/// Label-Anbieter hinter ShippingLabelPort (Slice 1: nur Speicherung / Stub).
enum ShippingLabelProvider {
  none
  internetmarke
  dhl_parcel
}

enum StockReservationStatus {
  active
  committed
  released
  expired
}

enum StockMovementReason {
  reservation_hold
  reservation_release
  reservation_commit
  warehouse_ship
  warehouse_return
  manual_adjustment
  /// POS-Verkauf über Zettle (Epic 6).
  pos_sale
  /// POS-Retoure/Refund über Zettle (Epic 6).
  pos_refund
}

enum ZettlePurchaseSyncStatus {
  processed
  skipped
  failed
  pending_retry
}

/// Shop → Zettle Inventory-Delta (Online-Verkauf / Storno / Retoure).
enum ZettleInventoryPushKind {
  shop_sale
  shop_return
}

enum ZettleInventoryPushStatus {
  pending
  processed
  skipped
  failed
}

enum IntegrationOutboxStatus {
  pending
  published
  failed
}

enum WebhookInboxStatus {
  received
  processed
  failed
}

/// Versanddienst für Sendungsverfolgung (Admin + E-Mail).
enum ShippingCarrier {
  DHL
  DPD
  UPS
  Hermes
}

/// Fortlaufende Rechnungsnummer (eine Zeile, atomar inkrementieren).
model InvoiceCounter {
  id      Int @id @default(1)
  nextSeq Int @default(1) @map("next_seq")

  @@map("invoice_counter")
}

/// Shop-Promotion (Rabatt auf Bestellung); MVP: ein Typ, Code oder automatisch.
model Promotion {
  id                     String   @id @default(cuid())
  title                  String
  promotionType          String   @default("order_discount") @map("promotion_type")
  applicationMode        String   @map("application_mode")
  code                   String?  @unique
  discountValueType      String   @map("discount_value_type")
  discountValue          Int      @map("discount_value")
  minimumRequirementType String   @map("minimum_requirement_type")
  minimumCartValueCents  Int?     @map("minimum_cart_value_cents")
  /// Nur `free_shipping`: `all` = jedes Land, `allow` = nur in `freeShippingCountryCodes`, `deny` = außer diesen.
  freeShippingCountryScope  String   @default("all") @map("free_shipping_country_scope")
  /// ISO-3166-1 alpha-2, Großbuchstaben; je nach `freeShippingCountryScope` Positiv- oder Negativliste.
  freeShippingCountryCodes  String[] @default([]) @map("free_shipping_country_codes")
  startDate              DateTime @map("start_date")
  endDate                DateTime @map("end_date")
  isEnabled              Boolean  @default(false) @map("is_enabled")
  publishedOnce          Boolean  @default(false) @map("published_once")
  usageCount             Int      @default(0) @map("usage_count")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  orders                 Order[]

  @@index([applicationMode, isEnabled, startDate, endDate])
  @@map("promotions")
}

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique @map("order_number")
  email               String
  phone               String?     @map("phone")
  /// Optional link to a verified customer account (Epic 3). Guest orders stay null until Slice 4 attach.
  customerId          String?     @map("customer_id")
  customer            Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  paymentMethod       String      @map("payment_method")
  /// shipping = Versand; pickup = Abholung vor Ort (keine Versandkosten).
  deliveryMethod      String      @default("shipping") @map("delivery_method")
  status              String      @default("bestaetigt") @map("status")
  fulfillmentStatus   FulfillmentStatus @default(unfulfilled) @map("fulfillment_status")
  shippingFirstName   String      @map("shipping_first_name")
  shippingLastName    String      @map("shipping_last_name")
  shippingCompany     String?     @map("shipping_company")
  shippingLine1       String      @map("shipping_line1")
  shippingLine2       String?     @map("shipping_line2")
  shippingZip         String      @map("shipping_zip")
  shippingCity        String      @map("shipping_city")
  shippingCountry     String      @default("DE") @map("shipping_country")
  billingFirstName    String      @map("billing_first_name")
  billingLastName     String      @map("billing_last_name")
  billingCompany      String?     @map("billing_company")
  billingLine1        String      @map("billing_line1")
  billingLine2        String?     @map("billing_line2")
  billingZip          String      @map("billing_zip")
  billingCity         String      @map("billing_city")
  billingCountry      String      @default("DE") @map("billing_country")
  customerNote        String?     @map("customer_note")
  subtotalGrossCents  Int         @map("subtotal_gross_cents")
  shippingCents       Int         @default(0) @map("shipping_cents")
  taxAmountCents      Int         @map("tax_amount_cents")
  totalGrossCents     Int         @map("total_gross_cents")
  /// Rabatt auf Warenwert (Cent), vor Versand; bei EU aus Brutto-Warenwert, bei Drittland aus Netto-Warenwert.
  discountOffSubtotalCents Int    @default(0) @map("discount_off_subtotal_cents")
  promotionId         String?     @map("promotion_id")
  promotion           Promotion?  @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionTitleSnapshot String?  @map("promotion_title_snapshot")
  promotionCodeSnapshot  String?  @map("promotion_code_snapshot")
  /// true = EU-27: Katalogpreise inkl. USt.; false = Drittland: Netto, keine ausgewiesene USt.
  vatApplies          Boolean     @default(true) @map("vat_applies")
  shippingCarrier     ShippingCarrier? @map("shipping_carrier")
  trackingNumber      String?     @map("tracking_number")
  invoiceNumber       String?     @unique @map("invoice_number")
  invoiceIssuedAt     DateTime?   @map("invoice_issued_at")
  currency            String      @default("EUR")
  idempotencyKey      String?     @unique @map("idempotency_key")
  createdAt           DateTime    @default(now()) @map("created_at")
  items               OrderItem[]
  emailLogs           EmailLog[]
  statusHistory       OrderStatusHistory[]
  events              OrderEvent[]
  payments            OrderPayment[]
  stockReservations   StockReservation[]
  shipments           Shipment[]

  @@index([customerId, createdAt])
  @@map("orders")
}

/// Physische Sendung zu einer Warenbestellung (Epic 7).
model Shipment {
  id                 String                @id @default(cuid())
  orderId            String                @map("order_id")
  order              Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status             ShipmentStatus        @default(draft)
  /// Anzeigename / manueller Carrier (optional bis Label-Kauf).
  carrier            ShippingCarrier?
  trackingNumber     String?               @map("tracking_number")
  labelProvider      ShippingLabelProvider @default(none) @map("label_provider")
  /// Externe Provider-Referenz (INTERNETMARKE/DHL) — Idempotenz später.
  labelExternalRef   String?               @map("label_external_ref")
  /// Privater Object-Storage-Key für Label-PDF (Store folgt später).
  labelStorageKey    String?               @map("label_storage_key")
  labelPurchasedAt   DateTime?             @map("label_purchased_at")
  voidedAt           DateTime?             @map("voided_at")
  shippedAt          DateTime?             @map("shipped_at")
  deliveredAt        DateTime?             @map("delivered_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  @@index([orderId, status])
  @@index([labelExternalRef])
  @@map("shipments")
}

model StockReservation {
  id          String                 @id @default(cuid())
  orderId     String                 @map("order_id")
  order       Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String                 @map("product_id")
  product     Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariantId String            @map("product_variant_id")
  productVariant   ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  quantity    Int
  status      StockReservationStatus @default(active)
  expiresAt   DateTime?              @map("expires_at")
  committedAt DateTime?              @map("committed_at")
  releasedAt  DateTime?              @map("released_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  movements   StockMovement[]

  @@unique([orderId, productVariantId])
  @@index([orderId, status])
  @@map("stock_reservations")
}

model StockMovement {
  id              String              @id @default(cuid())
  productId       String              @map("product_id")
  product         Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariantId String?            @map("product_variant_id")
  productVariant   ProductVariant?    @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  orderId         String?             @map("order_id")
  reservationId   String?             @map("reservation_id")
  reservation     StockReservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  quantityDelta   Int                 @map("quantity_delta")
  reason          StockMovementReason
  correlationId   String?             @map("correlation_id")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([productVariantId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

model IntegrationOutboxMessage {
  id            String                  @id @default(cuid())
  aggregateType String                  @map("aggregate_type")
  aggregateId   String                  @map("aggregate_id")
  eventType     String                  @map("event_type")
  payload       Json
  status        IntegrationOutboxStatus @default(pending)
  createdAt     DateTime                @default(now()) @map("created_at")
  publishedAt   DateTime?               @map("published_at")

  @@index([status, createdAt])
  @@map("integration_outbox_messages")
}

model WebhookInboxEntry {
  id               String             @id @default(cuid())
  provider         String
  externalEventId  String             @map("external_event_id")
  payloadHash      String?            @map("payload_hash")
  status           WebhookInboxStatus @default(received)
  metadata         Json?
  receivedAt       DateTime           @default(now()) @map("received_at")
  processedAt      DateTime?          @map("processed_at")

  @@unique([provider, externalEventId])
  @@map("webhook_inbox_entries")
}

model OrderPayment {
  id               String             @id @default(cuid())
  orderId          String             @map("order_id")
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider         String             @map("provider")
  providerRef      String             @map("provider_ref")
  status           OrderPaymentStatus @map("status")
  amountGrossCents Int                @map("amount_gross_cents")
  currency         String             @default("EUR")
  metadata         Json?              @map("metadata")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([orderId, createdAt])
  @@map("order_payments")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type")
  metadata  Json?    @map("metadata")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model EmailLog {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  emailType    String   @map("email_type")
  toEmail      String   @map("to_email")
  status       String
  providerId   String?  @map("provider_id")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([orderId, emailType])
  @@map("email_logs")
}

/// Editierbare Transaktions-Mail-Templates (Betreff + HTML/Text mit {{Variablen}}).
model EmailTemplate {
  id          String   @id @default(cuid())
  /// Stabiler Schlüssel, z. B. order_confirmation, email_verify.
  key         String   @unique
  name        String
  description String?
  subject     String
  htmlBody    String   @map("html_body") @db.Text
