# PostgreSQL (lokal oder gehostet, z. B. Supabase → Project Settings → Database)
# Supabase: Projekt darf nicht „pausiert“ sein (Dashboard). Verbindungsarten:
#
# Runtime auf Vercel (Preview + Production) — empfohlen:
# - Transaction Pooler Port 6543 (Supavisor). Viele Serverless-Invocations teilen wenige DB-Connections.
#   Session-Pooler :5432 hat oft pool_size=15 → EMAXCONNSESSION bei parallelen Preview/Prod-Instanzen.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Lokal / lange Node-Prozesse:
# - Direkt: db.PROJECT_REF.supabase.co:5432
# - oder Session Pooler :5432 (nicht für Serverless-Runtime)
DATABASE_URL="postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Optional: App-seitiger pg.Pool max (Default: 1 auf Vercel, 3 lokal). Override 1–20.
# PG_POOL_MAX="1"

# Supabase Pooler + Prisma Migrate: Bei P1002 (Advisory Lock Timeout) dieselbe Datenbank per Direktverbindung ansprechen.
# In Supabase: Database → Connection string → URI (Host db.PROJECT_REF.supabase.co, Port 5432, nicht aws-*.pooler).
# Dauerhaft für alle Prisma-CLI-Befehle (migrate, db seed): optional setzen — die Next.js-App nutzt weiter DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
# Einmalig nur für eine Migration:
# PRISMA_MIGRATE_DATABASE_URL="postgresql://…" npx prisma migrate deploy

# Optional: TLS-Verifikation steuern (pg + Prisma-Adapter)
# In development ist für typische Remote-Hosts (nicht localhost ohne sslmode) standardmäßig
# relaxiert. Dabei werden SSL-Query-Parameter (z. B. sslmode=require) aus der URL entfernt,
# weil `pg` sie sonst vor unserem ssl.rejectUnauthorized=false anwendet.
# Strikte Prüfung erzwingen: DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Auch in production relaxieren (nur wenn nötig): DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Supabase (Project Settings → API) — für @supabase/ssr Client & Session-Refresh
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Auth.js – z. B. openssl rand -base64 32 (lokal in `.env.local`, Vercel: Preview + Production)
AUTH_SECRET=""

# Optional: absolute App-URL in Produktion
# AUTH_URL="https://example.com"

# Öffentliche Shop-URL (Links in Bestell-E-Mails). Fallback: AUTH_URL, sonst VERCEL_URL.
# NEXT_PUBLIC_SITE_URL="https://example.com"

# Optional: Nominatim User-Agent für die Lieferadress-Karte auf /checkout/erfolg (OSMF-Richtlinie).
# Wenn leer: Fallback nutzt NEXT_PUBLIC_SITE_URL oder einen generischen Namen.
# NOMINATIM_USER_AGENT="MeinShop/1.0 (https://example.com)"

# Object Storage — Vercel Blob (ADR-0008). Öffentliche Branding-/Medien-Uploads.
# Vercel Dashboard → Storage → Blob (public) → Token mit dem Projekt verknüpfen.
# Lokal/CI: Token aus dem Store; ohne Token schlagen Uploads fehl, Storefront nutzt Static-Fallbacks.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"

# Transaktionale E-Mails — ausschließlich Resend: https://resend.com/docs/send-with-nextjs
# Domain in Resend verifizieren; Absender muss zu dieser Domain passen.
RESEND_API_KEY="re_…"
# Empfohlen auf Vercel (kein Parsing von Anführungszeichen/Apostroph):
# MAIL_FROM_EMAIL="info@deine-domain.de"
# MAIL_FROM_NAME="Jerrys"   # optional; sonst ShopSettings.emailFromName (Epic 11)
# Alternativ eine Zeile (wird normalisiert):
# MAIL_FROM=Jerrys <info@deine-domain.de>

# Optional: Rechnungs-Aussteller (überschreibt ShopSettings)
# INVOICE_SELLER_NAME="Dr. Alexander Berlin (e.U.)"
# INVOICE_SELLER_ADDRESS="Stargarder Str. 16\n10437 Berlin"
# INVOICE_UST_ID="DE276952027"
# INVOICE_STEUERNR=""

# PayPal (Zahlungsart „PayPal“ → Orders v2 Redirect, wenn Client ID + Secret gesetzt)
# Developer Dashboard → Apps & Credentials → Sandbox oder Live
# PAYPAL_CLIENT_ID="…"
# PAYPAL_CLIENT_SECRET="…"
# PAYPAL_ENV="sandbox"   # oder "live"
# Webhook (Developer Dashboard → App → Webhooks → ID der URL …/api/webhooks/paypal)
# PAYPAL_WEBHOOK_ID="WH-…"

# INTERNETMARKE REST (Epic 7) — https://developer.dhl.com/api-reference/deutsche-post-internetmarke-post-parcel-germany
# Nur REST (SOAP/OneClickForApp sunset 2025-12-31). Base: https://api-eu.dhl.com/post/de/shipping/im/v1
# Client ID/Secret: DHL Developer Portal. username/password: Portokasse.
# Portokasse einmalig unter „Meine Daten → Geschäftsanwendungen“ freigeben (sonst 401 beim ersten Token).
# Entwickler-Portokasse: Registrierung → Mail an it-csp@deutschepost.de (Portokasse-ID + E-Mail).
# Produktcode + Preis aus aktueller PPL/Products API (Cent). pageFormatId: GET /app/catalog?types=PAGE_FORMATS
# INTERNETMARKE_CLIENT_ID="…"
# INTERNETMARKE_CLIENT_SECRET="…"
# INTERNETMARKE_USERNAME="portokasse@example.com"
# INTERNETMARKE_PASSWORD="…"   # max. 22 Zeichen
# INTERNETMARKE_PRODUCT_CODE="1"
# INTERNETMARKE_PRODUCT_PRICE_CENTS="95"
# INTERNETMARKE_PAGE_FORMAT_ID="1"
# INTERNETMARKE_VOUCHER_LAYOUT="ADDRESS_ZONE"   # oder FRANKING_ZONE

# Optional: Seed-Admin (prisma db seed) und npm run admin:set-password (.env.local wird geladen)
# ADMIN_SEED_EMAIL="admin@example.com"
# ADMIN_SEED_PASSWORD="…"

# Epic 1: Cron/Manual — Reservierungs-Ablauf + Outbox-Publisher (+ Instagram-Sync wenn verbunden)
# COMMERCE_MAINTENANCE_SECRET="…"   # openssl rand -hex 32
# CRON_SECRET="…"                   # Vercel Cron: gleicher Wert wie oben ist ok; Cron sendet Bearer CRON_SECRET

# Instagram Feed (OAuth)
# Mode:
#   instagram = Business Login for Instagram → Instagram App ID/Secret
#               (Dashboard: Instagram → API setup with Instagram login → Business login settings)
#   facebook  = Facebook Login for Business → Meta App ID/Secret
#               (Dashboard: App-Einstellungen → Allgemeines; Plus Facebook Login OAuth-Redirects)
# Bei "Invalid platform app" oft facebook-Mode + Meta-App-ID nötig.
# Bei "Domain … nicht in den Domains der App": Meta App-Domains + Redirect exakt zur Production-URL;
#   Verbinden nur über Production-Admin (nicht Vercel-Preview). AUTH_URL auf Preview wird für OAuth ignoriert.
# INSTAGRAM_AUTH_MODE="facebook"
# INSTAGRAM_APP_ID="…"
# INSTAGRAM_APP_SECRET="…"
# Facebook Login for Business → Konfigurationen → Config-ID (Pflicht bei Mode facebook; sonst Invalid Scopes)
# INSTAGRAM_FB_LOGIN_CONFIG_ID="…"
# Stabile Site-URL (Production) — Pflicht für Meta; Preview-VERCEL_URL / Preview-AUTH_URL nicht nutzen
# NEXT_PUBLIC_SITE_URL="https://ecom-seven-livid.vercel.app"
# Explizite Redirect-URI empfohlen (muss 1:1 in Meta OAuth-Redirects + App-Domain Hostname stehen):
# INSTAGRAM_REDIRECT_URI="https://ecom-seven-livid.vercel.app/api/admin/instagram/callback"
# Optional: eigener 32-Byte-Key (Base64) oder 64 Hex für Token-Verschlüsselung; sonst Ableitung aus AUTH_SECRET
# INTEGRATIONS_ENCRYPTION_KEY=""

# Playwright E2E (optional; Fallback wie Seed oben)
# E2E_ADMIN_EMAIL="admin@example.com"
# E2E_ADMIN_PASSWORD="change-me-now"
