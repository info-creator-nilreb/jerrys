{
  "name": "jerrys",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack -p ${PORT:-3001}",
    "dev:cloud": "bash scripts/dev-cursor-cloud.sh",
    "dev:stop": "node scripts/stop-next-dev.mjs",
    "admin:set-password": "tsx scripts/set-admin-password.ts",
    "dev:turbo": "next dev --turbopack -p ${PORT:-3001}",
    "fix:next-cache": "rm -rf .next",
    "dev:fresh": "rm -rf .next && next dev --webpack -p ${PORT:-3001}",
    "build": "next build",
    "start": "next start",
    "architecture:check": "node scripts/check-module-boundaries.mjs",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "validate": "npm run architecture:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "security:semgrep": "semgrep scan --config=p/typescript --config=p/javascript --config=p/security-audit --error .",
    "lighthouse:local": "echo 'Dev-Server starten, dann: npx lighthouse http://127.0.0.1:${PORT:-3001} --only-categories=performance,accessibility,best-practices,seo --view'",
    "lighthouse:ci": "npx --yes @lhci/cli@0.14.0 autorun",
    "load:k6": "k6 run scripts/load/k6-smoke.js",
    "load:k6:go-live": "k6 run scripts/load/k6-go-live-30vu-stability.js",
    "security:surface": "bash scripts/security/go-live-surface-check.sh",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "content:migrate-storefront": "tsx scripts/migrate-storefront-content.ts",
    "catalog:import-shopify": "tsx scripts/import-shopify-products.ts",
    "orders:import-shopify": "tsx scripts/import-shopify-orders.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/postcss": "^4",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-text-align": "^3.22.3",
    "@tiptap/extension-text-style": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.544.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.30",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "web-vitals": "^4.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.1",
    "prisma": "^7.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "nodemailer": "9.0.5"
  }
}
